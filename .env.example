# MAC CMS sources (required when DATABASE_URL is not set)
MAC_CMS_SOURCES='[{"id":"sample","name":"Sample CMS","url":"https://example.com/api.php/provide/vod/","type":"json"}]'

# Database Connection (optional; enables CMS admin, recommendations, history, auth storage, and chatbot knowledge base)
# Replace with your Neon project connection string.
# DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require

# Authentication (optional; requires DATABASE_URL)
# Generate a secret: openssl rand -base64 32
# BETTER_AUTH_SECRET=your_generated_secret_here
# The base URL of your application
# BETTER_AUTH_URL=http://localhost:3000
# Access mode (optional): public allows browsing without login; private requires login.
# Defaults to private when auth is configured, public otherwise.
# ACCESS_MODE=public
# Runtime public origin for metadata URLs. Prefer this in deployed containers.
# HOST_URL=https://tv.example.com
# Build-time fallback public origin. GitHub Actions can provide this as a repository variable.
NEXT_PUBLIC_HOST_URL=http://localhost:3000
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# GitHub Issues feedback (optional, required for AD skip feedback submission)
GITHUB_ISSUES_TOKEN=github_pat_or_fine_grained_token_with_issues_write
GITHUB_OWNER=ban12-project
GITHUB_REPO=tv

# Chatbot (optional; requires DATABASE_URL and Authentication)
# OPENAI_API_KEY=your_openai_api_key
# CF_AIG_TOKEN=your_cloudflare_workers_ai_token
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# Douban Proxy Configuration (optional; enables Douban Top 250)
# These point to a Supabase Edge Function that proxies Douban API requests
# SUPABASE_ENDPOINT=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_key
